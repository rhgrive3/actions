{
  "name": "inkwave-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "INKWAVE (ZEVANT) build, verification, direct-source audit, multiplayer relay and account workspace",
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "build": "node scripts/build-inkwave.mjs inkwave-public _site",
    "build:diagnostic": "INKWAVE_BUILD_UNMINIFIED=1 node scripts/build-inkwave.mjs inkwave-public _site",
    "build:prod": "vite build",
    "build:account": "ZEVANT_ACCOUNT_ONLY=1 vite build",
    "dev": "vite",
    "check:patches": "node scripts/check-inkwave-patches.mjs --quick",
    "check:budget": "node scripts/check-inkwave-startup-budget.mjs _site",
    "audit:migration": "node scripts/inkwave-source-migration-audit.mjs",
    "test:direct-source": "node --test scripts/tests/inkwave-direct-source-ownership.test.mjs scripts/tests/inkwave-pages-source-identity.test.mjs scripts/tests/inkwave-lossless-lightmap.test.mjs",
    "test:relay": "node --test server/tests/relay-security.test.mjs server/tests/relay-clock-receipts.test.mjs server/tests/local-relay-fixture.test.mjs server/tests/browser-relay-fixture.test.mjs server/tests/issue-1033-relay-hit-nack.test.mjs",
    "test:account": "node --test account/tests/*.test.mjs",
    "test:quality": "node --experimental-vm-modules --experimental-global-webcrypto --test patches/local-quality/tests/nav-heuristic.test.mjs patches/local-quality/tests/pose-rotation.test.mjs patches/local-quality/tests/motion-fk-hotpath.test.mjs patches/local-quality/tests/prop-atlas.test.mjs patches/local-quality/tests/prop-retention.test.mjs && node patches/local-quality/tests/performance-v2-ao.test.mjs && node patches/local-quality/tests/performance-v2-geometry.test.mjs && node patches/local-quality/tests/performance-v2-topology.test.mjs",
    "test:backup": "python3 -m unittest discover -s tools/backup/tests -p \"test_*.py\" -v",
    "bench:aplus": "node scripts/benchmark-aplus-verification.mjs",
    "test": "npm run check:patches && npm run audit:migration && npm run test:direct-source && npm run test:quality && npm run test:relay && npm run test:account && npm run test:backup && npm run test:queue-recovery",
    "test:queue-recovery": "node --test patches/local-quality/tests/queue-30-lifecycle.test.mjs patches/local-quality/tests/queue-30-audio.test.mjs patches/local-quality/tests/queue-30-ribbons.test.mjs patches/local-quality/tests/special-vfx-zero-drag-parity.test.mjs patches/local-quality/tests/lobby-reflection-lifecycle.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "vite": "8.3.3"
  }
}

{
  "name": "inkwave-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "INKWAVE (ZEVANT) build, verification, direct-source audit, multiplayer relay and account workspace",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build-inkwave.mjs inkwave-public _site",
    "build:diagnostic": "INKWAVE_BUILD_UNMINIFIED=1 node scripts/build-inkwave.mjs inkwave-public _site",
    "build:prod": "vite build",
    "build:account": "ZEVANT_ACCOUNT_ONLY=1 vite build",
    "dev": "vite",
    "check:patches": "node scripts/check-inkwave-patches.mjs --quick",
    "check:budget": "node scripts/check-inkwave-startup-budget.mjs _site",
    "audit:migration": "node scripts/inkwave-source-migration-audit.mjs",
    "test:direct-source": "node scripts/ci/run-inkwave-test-suite.mjs direct-source",
    "test:relay": "node scripts/ci/run-inkwave-test-suite.mjs relay",
    "test:account": "node scripts/ci/run-inkwave-test-suite.mjs account",
    "test:quality": "node scripts/ci/run-inkwave-test-suite.mjs quality",
    "test:backup": "node scripts/ci/run-inkwave-test-suite.mjs backup",
    "bench:aplus": "node scripts/benchmark-aplus-verification.mjs",
    "test": "npm run test:ci-config && npm run check:patches && npm run audit:migration && npm run test:direct-source && npm run test:quality && npm run test:relay && npm run test:account && npm run test:backup && npm run test:queue-recovery && npm run test:memory",
    "test:queue-recovery": "node scripts/ci/run-inkwave-test-suite.mjs queue-recovery",
    "test:memory": "node scripts/ci/run-inkwave-test-suite.mjs memory",
    "test:ci-config": "node scripts/ci/run-inkwave-test-suite.mjs runner-contracts",
    "test:verifier": "node scripts/ci/run-inkwave-test-suite.mjs verifier",
    "test:acceptance": "node scripts/ci/run-inkwave-test-suite.mjs acceptance",
    "test:source-network": "node scripts/ci/run-inkwave-test-suite.mjs source-network",
    "test:source-quality": "node scripts/ci/run-inkwave-test-suite.mjs source-quality",
    "test:list": "node scripts/ci/run-inkwave-test-suite.mjs --list"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "vite": "8.3.3",
    "ws": "8.22.0"
  }
}

+// These hooks are trusted native phases, not asynchronous work queues. Never
+// publish completion or private damage receipts while any phase is pending.
+for(const phase of ['beforeActors','afterActors','afterProjectiles'])test(`pending ${phase} faults the session before native contacts can commit`,()=>{
+  let pending=false,resolve;
+  const wait=new Promise(r=>{resolve=r;});
+  const w=setup({[phase]:function(){assert.equal(this,w.world);return pending?wait:undefined;},warmup:0});
+  try{
+    for(let i=0;i<180;i++)assert.equal(w.step().ok,true);
+    shoot(w);const state=w.state(),effect=state.effects[0];
+    assert.ok(state.launches.length>0,'actual native paid fire occurred');
+    assert.ok(effect&&state.actors[1].hp<100,'native projectile flight/contact changed HP before the phase fault');
+    const selected=claim(effect),receipt=f.peekTrustedNativeContact(w.token,selected);
+    assert.ok(receipt,'the pre-fault contact was genuinely available');
+    const saved={...f.G},random=f.VM_MATH.random;
+    pending=true;
+    assert.deepEqual(w.step(),{ok:false,reason:'Asynchronous native authority phase: '+phase});
+    assert.equal(w.state().contacts,0,'fault retires every outstanding private contact');
+    assert.equal(f.peekTrustedNativeContact(w.token,selected),null);
+    assert.equal(f.commitTrustedNativeContact(w.token,receipt),null);
+    assert.equal(w.step().ok,false,'a pending hook cannot continue funding native simulation');
+    for(const [key,value]of Object.entries(saved))assert.equal(f.G[key],value,key);
+    assert.equal(f.VM_MATH.random,random,'realm RNG owner restored');
+  }finally{resolve();w.close();}
+});

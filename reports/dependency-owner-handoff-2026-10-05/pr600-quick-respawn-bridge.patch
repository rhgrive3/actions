   context.Actor.prototype.splat = function (attacker, cause = 'weapon') {
     const wasAlive = this.alive;
     const result = splat.call(this, attacker, cause);
-    if (wasAlive && !this.alive && cause !== 'weapon') this.respawnTimer = respawnTimeForCause(cause, respawnTuning);
+    // Gear already adjusted ordinary attack deaths. Only known environment
+    // routes replace that result with their separate respawn contract.
+    if (wasAlive && !this.alive && ['water', 'drowning', 'out-of-bounds', 'fall', 'void'].includes(cause)) this.respawnTimer = respawnTimeForCause(cause, respawnTuning);
     return result;
   };
 }

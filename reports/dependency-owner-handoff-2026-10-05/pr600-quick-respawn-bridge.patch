diff --git a/patches/reliability/tests/pr600-respawn-cause-probe.test.mjs b/patches/reliability/tests/pr600-respawn-cause-probe.test.mjs
new file mode 100644
index 0000000..4f744fc
--- /dev/null
+++ b/patches/reliability/tests/pr600-respawn-cause-probe.test.mjs
@@ -0,0 +1,29 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {fixture} from './controls-fixture.mjs';
+const causes=['weapon','shooter','bomb','unknown-attack','water','drowning','out-of-bounds','fall','void'];
+const environment=new Map([['water',7],['drowning',7],['out-of-bounds',5.5],['fall',5.5],['void',5.5]]);
+function equip(f,ap,eligible){
+ const a=f.make('shooter');a.s3.loadout=Array.from({length:3},()=>({main:ap?'quickRespawn':'none',subs:Array(3).fill(ap?'quickRespawn':'none')}));a.setWeapon('shooter');a.s3.previousLifeNoSplat=eligible;a.s3.splatsThisLife=0;return a;
+}
+test('ordinary and unknown attack causes retain real QR; environment aliases retain their own timers',async t=>{
+ const f=await fixture(),rows=[];
+ for(const ap of [0,57])for(const eligible of [false,true])for(const cause of causes){
+  const a=equip(f,ap,eligible);assert.ok(Math.abs(a.s3.modifiers.quickRespawn-(ap?1/3:1))<1e-10);
+  a.splat(null,cause);assert.equal(a.alive,false);const expected=environment.get(cause)??(ap&&eligible?5.5:8.5);
+  assert.ok(Math.abs(a.respawnTimer-expected)<1e-10,`${ap}AP eligible=${eligible} ${cause}: ${a.respawnTimer}`);
+  rows.push({ap,eligible,cause,respawn:a.respawnTimer});
+  a.respawnTimer=2;a.splat(null,cause);assert.equal(a.respawnTimer,2,'duplicate splat does not restart respawn');
+ }
+ t.diagnostic(JSON.stringify({causeMatrix:rows}));
+});
+test('actual lethal damage routes Shooter and Bomb sources through Gear without overwrite',async()=>{
+ const f=await fixture();
+ for(const cause of ['shooter','bomb'])for(const ap of [0,57]){
+  const a=equip(f,ap,true),attacker=f.make('shooter');attacker.team=1;a.invuln=0;a.hp=100;
+  assert.equal(a.damage(200,attacker,cause),true);assert.equal(a.alive,false);assert.equal(a.respawnTimer,ap?5.5:8.5,cause);
+ }
+});
+test('a splat in the current life still prevents QR for ordinary attack aliases',async()=>{
+ const f=await fixture();for(const cause of ['weapon','shooter','bomb','unknown-attack']){const a=equip(f,57,true);a.s3.splatsThisLife=1;a.splat(null,cause);assert.equal(a.respawnTimer,8.5,cause);}
+});

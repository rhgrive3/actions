+// Focused composition checks. PR322/469 supply the declared Storm dependency;
+// renderer surfaces are stubs, but the cloud loop and clock adapter are native.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+import {parse} from '../../loading-cache/vendor/acorn.mjs';
+import {adaptSource} from '../../splatoon3/adapter.mjs';
+import {adaptStormEffects} from '../../splatoon3/storm-effects-adapter.mjs';
+import {adaptTouchLayout} from '../../touch-layout/adapter.mjs';
+import {adaptReliability} from '../../reliability/adapter.mjs';
+import {adaptQualitySource} from '../../local-quality/adapter.mjs';
+import {adaptNetworkSource} from '../adapter.mjs';
+import {collectStormHit,applyStormHits,cloudCoversActor} from '../../splatoon3/runtime/storm-effects.mjs';
+import {fixture} from './robustness-fixture.mjs';
+const rel='src/game/weapons.js',raw=fs.readFileSync(new URL('../../../inkwave-public/'+rel,import.meta.url),'utf8');
+// The dedicated candidate stages PR322 as a declared dependency. A completed
+// combined installer may already own the same transform; never apply it twice.
+let pre=adaptSource(rel,raw);
+if(!pre.includes('collectStormHit(rainHits, e, c,'))pre=adaptSource(rel,adaptStormEffects(rel,raw));
+for(const adapt of [adaptTouchLayout,adaptReliability,adaptQualitySource])pre=adapt(rel,pre);
+const collect='collectStormHit(rainHits, e, c, sp.dps * dt);',direct="e.damage(sp.dps * dt, c.owner, 'storm');";
+assert.equal(pre.split(collect).length,2);
+test('one direct or one collected recipient sink receives the same clock conversion',()=>{
+ const legacy=adaptNetworkSource(rel,pre.replace(collect,direct));assert(legacy.includes('e.damage(sp.dps * (peer ? dt : stepDt),'));
+ const collected=adaptNetworkSource(rel,pre);assert(collected.includes('collectStormHit(rainHits, e, c, sp.dps * (peer ? dt : stepDt))'));
+ assert(collected.includes('if (peer && tick !== steps-1) break;'));
+});
+test('missing, mixed and duplicate recipient sinks fail closed',()=>{
+ for(const replacement of ['',collect+'\n'+direct,collect+'\n'+collect,direct+'\n'+direct])assert.throws(()=>adaptNetworkSource(rel,pre.replace(collect,replacement)),/expected exactly one direct or collected sink/);
+});
+function cloudMethod(code,context){let node;function visit(n){if(!n||typeof n!=='object')return;if(n.type==='MethodDefinition'&&n.key.name==='_updateClouds')node=n;for(const v of Object.values(n))if(Array.isArray(v))v.forEach(visit);else if(v&&typeof v==='object')visit(v);}visit(parse(code,{sourceType:'module',ecmaVersion:'latest'}));assert(node);return vm.runInNewContext(`({${code.slice(node.start,node.end)}})._updateClouds`,context);}
+test('installed 24DPS collector keeps recipient dt and overlap owner under ghost catch-up',async()=>{
+ const f=await fixture();f.installSubSpecialFidelity(f,f.profile);assert.equal(f.SPECIALS.storm.dps,24);const hits=[];
+ f.G.fx={rain(){}};f.G.physics.los=()=>true;f.G.actors=[{team:1,alive:true,remote:false,pos:new f.THREE.Vector3(),damage(amount,owner){hits.push({amount,owner:owner.nid});return false;}}];
+ const context={G:f.G,SPECIALS:f.SPECIALS,SIM_DT:1/60,clamp:(v,a,b)=>Math.max(a,Math.min(b,v)),_v:new f.THREE.Vector3(),_v2:new f.THREE.Vector3(),DOWN:new f.THREE.Vector3(0,-1,0),_hit:{},collectStormHit,applyStormHits,emit(){}};
+ const loop=cloudMethod(adaptNetworkSource(rel,pre),context);
+ const cloud=(nid,steps=null)=>{const group=new f.THREE.Group();group.position.set(0,4,0);return{owner:{nid,addTurf(){}},team:0,group,dir:new f.THREE.Vector3(),t:1,dur:8,rainT:1,ghost:steps!==null,_netBornTick:0,_netSteps:60,_netPeer:steps===null?null:{sim:60+steps-1}};};
+ for(const dt of [1/30,1/120])for(const reverse of [false,true]){hits.length=0;const clouds=[cloud(2),cloud(1,6)];if(reverse)clouds.reverse();loop.call({clouds,_releaseCloud(){}},dt);assert.equal(hits.length,1);assert.equal(hits[0].owner,1);assert(Math.abs(hits[0].amount-24*dt)<1e-10);}
+ hits.length=0;loop.call({clouds:[cloud(1,0)],_releaseCloud(){}},1/60);assert.equal(hits.length,0,'frozen owner has no new recipient hit');
+ hits.length=0;f.projectiles.clouds=[cloud(1,6)];f.projectiles._updateClouds(1/30);assert.equal(hits.length,1);assert(Math.abs(hits[0].amount-.8)<1e-10,'ordinary installed sink keeps recipient dt');f.projectiles.clouds=[];
+});
+test('resource coverage includes the last pre-update live interval but excludes expired/dead recipients',()=>{
+ const pos={x:0,y:0,z:0,clone(){return {...this};}},a={alive:true,pos},G={physics:{los:()=>true}},SPECIALS={storm:{radius:10}};
+ for(const t of [7.7,7.8,479/60])assert.equal(cloudCoversActor({t,dur:8,group:{position:{x:0,y:4,z:0}}},a,G,SPECIALS),true);
+ for(const t of [8,8.01])assert.equal(cloudCoversActor({t,dur:8,group:{position:{x:0,y:4,z:0}}},a,G,SPECIALS),false);
+ a.alive=false;assert.equal(cloudCoversActor({t:1,dur:8,group:{position:{x:0,y:4,z:0}}},a,G,SPECIALS),false);
+});

+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {fixture} from './controls-fixture.mjs';
+import {resetPlatformInput} from '../../local-quality/platform-input.mjs';
+const DT=1/60;
+async function setup(){const f=await fixture({network:true}),a=f.make('shooter');f.G.actors=[a];f.G.camera={position:new f.THREE.Vector3(0,20,0)};f.G.settings={...f.DEFAULT_SETTINGS,aimAssist:0};f.G.match.canRespawn=()=>false;const input=new f.Input({}),rig={yaw:0,pitch:0,mapK:0},c=new f.PlayerController(a,rig,input);c.computeAim=()=>{};f.G.rig=rig;f.G.projectiles.throwBomb=()=>f.shots.push({kind:'bomb'});a.kidT=99;return {...f,a,r:a.weaponRunner,input,c};}
+function trace(h,n=12){const rows=[];for(let i=0;i<n;i++){h.tick(h.a);rows.push({i,shots:h.shots.length,queued:h.r.s3ShooterPendingFirst,remaining:h.r.s3ShooterFirstRemaining,sub:h.r.aimingSub});}return rows;}
+for(const cancel of ['tap','sub-request','explicit-cancel-owner','blur','map-mouse','map-pad'])test('pending-first '+cancel,async t=>{
+ const h=await setup();h.a.intent.fire=true;h.tick(h.a);assert.equal(h.shots.length,0);assert.equal(h.r.s3ShooterPendingFirst,true);
+ h.a.intent.fire=false;
+ if(cancel==='sub-request')h.a.intent.sub=true;
+ if(cancel==='explicit-cancel-owner'){h.r.cancelMainForSub();h.r.aimingSub=true;h.a.intent.sub=true;}
+ if(cancel==='blur')resetPlatformInput(h.input,h.c);
+ if(cancel.startsWith('map')){h.input.keys.add('Tab');if(cancel==='map-mouse')h.input.mouse.left=true;else {h.input.lastDevice='pad';h.input.pad={buttons:Array.from({length:17},(_,i)=>({value:i===7?1:0,pressed:i===7})),axes:[0,0,0,0]};}h.c.update(DT);}
+ const rows=trace(h);
+ if(['explicit-cancel-owner','blur','map-mouse'].includes(cancel))assert.equal(h.shots.filter(s=>s.kind==='shooter').length,0,cancel);
+ else assert.ok(h.shots.some(s=>s.kind==='shooter'),cancel);
+ if(cancel==='sub-request')assert.equal(h.r.aimingSub,true);
+ t.diagnostic(JSON.stringify({cancel,rows,shots:h.shots}));
+});
+
+for(const boundary of ['blur','map-mouse'])test('swim queue '+boundary+' is discarded before pending-first admission',async()=>{
+ const h=await setup();h.a.intent.squid=true;h.tick(h.a,10);h.a.intent.fire=true;h.tick(h.a,2);assert.equal(h.r.s3SwimFireQueued,true);
+ if(boundary==='blur')resetPlatformInput(h.input,h.c);else {h.input.keys.add('Tab');h.c.update(DT);}
+ h.a.intent.fire=false;trace(h,25);assert.equal(h.shots.length,0);assert.equal(h.r.s3SwimFireQueued,false);assert.equal(h.r.s3ShooterPendingFirst,false);
+});
+test('cancellation permits a later fresh human press without shortening its startup',async()=>{
+ const h=await setup();h.a.intent.fire=true;h.tick(h.a);resetPlatformInput(h.input,h.c);h.tick(h.a,10);assert.equal(h.shots.length,0);
+ h.a.intent.fire=true;h.tick(h.a,2);assert.equal(h.shots.length,0);h.tick(h.a);assert.equal(h.shots.length,1);
+});
+test('admitted sub throws once after explicit pending cancel without phantom main',async()=>{
+ const h=await setup();h.a.intent.fire=true;h.tick(h.a);h.r.cancelMainForSub();h.a.intent.fire=false;h.a.intent.sub=true;h.tick(h.a,5);assert.equal(h.r.aimingSub,true);h.a.intent.sub=false;h.tick(h.a,15);assert.deepEqual(h.shots.map(s=>s.kind),['bomb']);
+});
+
+function padStep(h,zr){h.setPads([{index:0,id:'standard',connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},(_,i)=>({pressed:i===7&&zr,value:i===7&&zr?1:0}))}]);h.input.pollPad();h.c.update(DT);h.tick(h.a);h.input.endFrame();}
+for(const when of ['already-open','open-after-press','mouse-click-during-pad-buffer'])test('Map preserves accepted pad short tap: '+when,async()=>{
+ const h=await setup();if(when!=='open-after-press')h.input.keys.add('Tab');padStep(h,true);assert.equal(h.r.s3ShooterPendingFirst,true);assert.equal(h.r.s3ShooterPendingInputPad,true);
+ h.input.keys.add('Tab');if(when==='mouse-click-during-pad-buffer')h.input.mouse.left=true;for(let i=0;i<8;i++)padStep(h,false);assert.equal(h.shots.length,1);
+});
+test('new mouse origin replaces old completed pad receipt and Map cancels that queue',async()=>{
+ const h=await setup();padStep(h,true);for(let i=0;i<8;i++)padStep(h,false);assert.equal(h.shots.length,1);
+ h.input.lastDevice='kbm';h.input.mouse.left=true;h.c.update(DT);h.tick(h.a);assert.equal(h.r.s3ShooterPendingInputPad,false);assert.equal(h.r.s3ShooterPendingFirst,true);
+ h.input.keys.add('Tab');h.c.update(DT);h.tick(h.a,8);assert.equal(h.shots.length,1);
+});
+test('blur still cancels a pad-origin committed pending shot and its receipt',async()=>{
+ const h=await setup();h.input.keys.add('Tab');padStep(h,true);resetPlatformInput(h.input,h.c);assert.equal(h.r.s3ShooterPendingInputPad,false);h.tick(h.a,8);assert.equal(h.shots.length,0);
+});
+
+test('native Runner reset retires pad receipt before a new mouse pending shot',async()=>{
+ const h=await setup();padStep(h,true);assert.equal(h.r.s3ShooterPendingInputPad,true);h.r.reset();assert.equal(h.r.s3ShooterPendingInputPad,false);
+ h.input.lastDevice='kbm';h.input.mouse.left=true;h.c.update(DT);h.tick(h.a);assert.equal(h.r.s3ShooterPendingInputPad,false);h.input.keys.add('Tab');h.c.update(DT);h.tick(h.a,8);assert.equal(h.shots.length,0);
+});
+
+for(const map of [false,true])test('new admitted ZR protects an existing mouse pending shot '+map,async()=>{
+ const h=await setup();h.input.mouse.left=true;h.c.update(DT);h.tick(h.a);assert.equal(h.r.s3ShooterPendingFirst,true);assert.equal(h.r.s3ShooterPendingInputPad,false);
+ if(map)h.input.keys.add('Tab');padStep(h,true);assert.equal(h.r.s3ShooterPendingInputPad,true);h.input.mouse.left=false;for(let i=0;i<8;i++)padStep(h,false);assert.equal(h.shots.length,1);
+});

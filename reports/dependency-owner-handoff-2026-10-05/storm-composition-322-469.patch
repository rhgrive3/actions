index 0000000..fb01c3b
--- /dev/null
+++ b/patches/local-quality/tests/storm-composition.test.mjs
@@ -0,0 +1,32 @@
+// Composition regression: current #392/#510 helpers plus the actual #322/#469
+// gauge helper. This deliberately does not claim a full installed PR322 build.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {advanceTenacity,TENACITY_RATES} from '../tenacity.mjs';
+import {hudFrameSnapshot} from '../hud-snapshots.mjs';
+import {stormGaugeFrame,advanceStormLock} from '../../splatoon3/runtime/storm-effects.mjs';
+const dt=1/60,close=(a,b)=>assert.ok(Math.abs(a-b)<1e-10,`${a} != ${b}`);
+function actor(){return {alive:true,remote:false,team:0,special:0,specialActive:null,stormGaugeLock:6,ink:100,hp:100,weaponId:'charger',weaponRunner:{charge:0},s3:{loadout:[{main:'tenacity'}],tenacityBaseCost:220},specialCost:()=>180,specialFrac(){return this.special/180},specialReady(){return this.special>=180&&!this.specialActive&&!(this.stormGaugeLock>0)},specialDisplayFrame(frame){return stormGaugeFrame(this,frame)}};}
+function match(a){return {mode:'turf',state:'playing',time:60,opts:{},actors:[a,{alive:true,team:1},{alive:true,team:1}],teamSummary:()=>[],controller:{}};}
+test('Tenacity cannot refill used Storm after throwing state ends',()=>{
+ const a=actor(),m=match(a),events=[];advanceTenacity(m,dt,(...e)=>events.push(e));close(a.special,0);close(a.stormGaugeLock,6);assert.equal(events.length,0);
+});
+test('existing lock clock releases passive admission exactly at expiry and retains normal rate/ready event',()=>{
+ const a=actor(),m=match(a),events=[];a.stormGaugeLock=2*dt;
+ advanceStormLock(a,dt);advanceTenacity(m,dt,(...e)=>events.push(e));close(a.special,0);
+ advanceStormLock(a,dt);advanceTenacity(m,dt,(...e)=>events.push(e));const amount=TENACITY_RATES[1]*dt*180/220;close(a.special,amount);close(a.stormGaugeLock,0);
+ a.special=180-amount/2;advanceTenacity(m,dt,(...e)=>events.push(e));close(a.special,180);assert.equal(events.length,1);assert.equal(events[0][0],'special:ready');
+});
+test('510 copies the same used gauge into desktop/mobile without replacing either transport',()=>{
+ const a=actor(),m=match(a),game={settings:{showFps:false}},w={special:'storm'};
+ const draw=()=>hudFrameSnapshot(game,m,a,w,0,[],[],null,false,{inkMax:100,hp:100},{bomb:{inkCost:70}});
+ const frame=draw(),mobile=game._hudTransport.mobile;close(frame.special,.75);close(mobile.special,.75);assert.equal(frame.specialActive,true);assert.equal(mobile.activeSp,true);assert.equal(mobile.ready,false);
+ // 469's standalone main connection may run afterwards; it must be idempotent.
+ a.specialDisplayFrame(frame);close(frame.special,mobile.special);
+ a.stormGaugeLock=0;a.special=45;assert.equal(draw(),frame);assert.equal(game._hudTransport.mobile,mobile);close(frame.special,.25);close(mobile.special,.25);assert.equal(mobile.activeSp,false);
+});
+test('normal actors without the optional Storm projection keep native HUD/readiness',()=>{
+ const a=actor();delete a.specialDisplayFrame;delete a.stormGaugeLock;a.special=180;
+ const game={settings:{}},frame=hudFrameSnapshot(game,match(a),a,{},0,[],[],null,false,{inkMax:100,hp:100},{bomb:{inkCost:70}});
+ close(frame.special,1);assert.equal(frame.specialReady,true);assert.equal(game._hudTransport.mobile.ready,true);
+});

  "verified_findings": [
    {
      "id": "esetb_wrapper",
      "source_ids": [
        "H01"
      ],
      "status": "source_code_verified",
      "facts": [
        "Esetb.Load calls Romfs.Decompress before BYML parsing.",
        "PtclBin must be a BYML aligned binary node; Esets preserves stored set-name order.",
        "VfxFile is built from PtclBin."
      ]
    },
    {
      "id": "vfxb_version_sections",
      "source_ids": [
        "H02"
      ],
      "status": "source_code_verified",
      "facts": [

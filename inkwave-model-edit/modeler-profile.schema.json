{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modeler-profile.schema.json",
  "title": "INKWAVE AI Modeler Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "style",
    "look",
    "face",
    "materials",
    "sculpt",
    "shape",
    "weapon",
    "view"
  ],
  "properties": {
    "version": {
      "const": 4
    },
    "target": {
      "enum": [
        "inkwave-character",
        "inkwave-weapon"
      ]
    },
    "notes": {
      "type": "string"
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hair",
        "outfit",
        "skin",
        "eyes",
        "hat",
        "brows"
      ],
      "properties": {
        "hair": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "outfit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "skin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "eyes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "hat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "brows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "look": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ink",
        "glow"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "glow": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mouthCurve",
        "mouthWidth",
        "mouthOpen",
        "mouthTilt",
        "lookX",
        "lookY"
      ],
      "properties": {
        "mouthCurve": {
          "type": "number",
          "minimum": -0.2,
          "maximum": 1.5
        },
        "mouthWidth": {
          "type": "number",
          "minimum": 0.55,
          "maximum": 1.6
        },
        "mouthOpen": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthTilt": {
          "type": "number",
          "minimum": -0.7,
          "maximum": 0.7
        },
        "lookX": {
          "type": "number",
          "minimum": -0.35,
          "maximum": 0.35
        },
        "lookY": {
          "type": "number",
          "minimum": -0.25,
          "maximum": 0.25
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skinRoughness",
        "skinClearcoat",
        "clothRoughness",
        "hairRoughness",
        "hairClearcoat",
        "hairTipColor",
        "hairTipStrength",
        "hairTranslucency",
        "weaponRoughness"
      ],
      "properties": {
        "skinRoughness": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "skinClearcoat": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "clothRoughness": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "hairRoughness": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 1
        },
        "hairClearcoat": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hairTipColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "hairTipStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hairTranslucency": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8
        },
        "weaponRoughness": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 1
        }
      }
    },
    "sculpt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mirror",
        "defaultRadius",
        "handles"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mirror": {
          "type": "boolean"
        },
        "defaultRadius": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 0.5
        },
        "handles": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "part",
              "center",
              "offset",
              "scale",
              "radius",
              "strength",
              "mirror"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "part": {
                "enum": [
                  "skin",
                  "hair",
                  "cloth",
                  "eyes",
                  "weapon",
                  "all"
                ]
              },
              "center": {
                "$ref": "#/$defs/vec3"
              },
              "offset": {
                "$ref": "#/$defs/vec3"
              },
              "scale": {
                "$ref": "#/$defs/scale3"
              },
              "radius": {
                "type": "number",
                "minimum": 0.005,
                "maximum": 0.5
              },
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "mirror": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overallScale": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.45
        },
        "headWidth": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.5
        },
        "headHeight": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.5
        },
        "headDepth": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.5
        },
        "headOffsetX": {
          "type": "number",
          "minimum": -0.15,
          "maximum": 0.15
        },
        "headOffsetY": {
          "type": "number",
          "minimum": -0.15,
          "maximum": 0.15
        },
        "headOffsetZ": {
          "type": "number",
          "minimum": -0.15,
          "maximum": 0.15
        },
        "jawWidth": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.45
        },
        "cheekWidth": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.45
        },
        "eyeScale": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.5
        },
        "eyeSpacing": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.4
        },
        "eyeHeight": {
          "type": "number",
          "minimum": -0.1,
          "maximum": 0.1
        },
        "earLength": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.7
        },
        "hairVolume": {
          "type": "number",
          "minimum": 0.55,
          "maximum": 1.7
        },
        "hairLength": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.8
        },
        "hairLift": {
          "type": "number",
          "minimum": -0.15,
          "maximum": 0.2
        },
        "shoulderWidth": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.4
        },
        "torsoWidth": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.4
        },
        "torsoDepth": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.4
        },
        "torsoLength": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.35
        },
        "hipWidth": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.4
        },
        "armLength": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.35
        },
        "armThickness": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.45
        },
        "legLength": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.35
        },
        "legThickness": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.45
        },
        "shoeScale": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.55
        },
        "shoeLength": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.65
        }
      },
      "required": [
        "overallScale",
        "headWidth",
        "headHeight",
        "headDepth",
        "headOffsetX",
        "headOffsetY",
        "headOffsetZ",
        "jawWidth",
        "cheekWidth",
        "eyeScale",
        "eyeSpacing",
        "eyeHeight",
        "earLength",
        "hairVolume",
        "hairLength",
        "hairLift",
        "shoulderWidth",
        "torsoWidth",
        "torsoDepth",
        "torsoLength",
        "hipWidth",
        "armLength",
        "armThickness",
        "legLength",
        "legThickness",
        "shoeScale",
        "shoeLength"
      ]
    },
    "weapon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scaleX",
        "scaleY",
        "scaleZ",
        "barrelLength"
      ],
      "properties": {
        "kind": {
          "enum": [
            "shooter",
            "roller",
            "charger",
            "blaster",
            "dualies",
            "slosher",
            "splatling",
            "bomb"
          ]
        },
        "scaleX": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.7
        },
        "scaleY": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.7
        },
        "scaleZ": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.7
        },
        "barrelLength": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.8
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode",
        "wireframe",
        "grid",
        "referenceOpacity"
      ],
      "properties": {
        "mode": {
          "enum": [
            "perspective",
            "front",
            "right",
            "back",
            "left",
            "quad"
          ]
        },
        "wireframe": {
          "type": "boolean"
        },
        "grid": {
          "type": "boolean"
        },
        "referenceOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "referenceScale": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 3
        },
        "referenceX": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "referenceY": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "isolatePart": {
          "enum": [
            "all",
            "skin",
            "hair",
            "cloth",
            "eyes",
            "tank",
            "weapon"
          ]
        },
        "showHandles": {
          "type": "boolean"
        },
        "xrayHandles": {
          "type": "boolean"
        },
        "quad": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "scale3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3
        },
        {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3
        },
        {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3
        }
      ],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
